# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Evolution API (WhatsApp)
# Credenciais podem ser configuradas na tela Integração WhatsApp (URL + API Key).
# Variáveis abaixo são fallback opcional para Edge Functions em desenvolvimento:
VITE_EVOLUTION_API_URL=
VITE_EVOLUTION_API_KEY=
VITE_EVOLUTION_INSTANCE=crm-whatsapp

# SSO corporativo (opcional)
# VITE_SSO_ENABLED=true
# VITE_SSO_PROVIDER=azure

# Edge Functions secrets (set in Supabase Dashboard > Edge Functions > Secrets)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=crm-whatsapp
# EVOLUTION_NOTIFY_PHONE=5511999999999
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=your-openai-api-key
# AI_MODEL=gpt-4o-mini
